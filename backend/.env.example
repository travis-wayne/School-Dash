# Port the Express server listens on
PORT=3000

# Set to development to activate morgan HTTP logging
# (morgan logging only activates when this is set to development)
NODE_ENV=development

# Atlas connection string (cloud)
MONGO_URL=mongodb+srv://<user>:<pass>@cluster.mongodb.net/schooldash

# Local MongoDB connection string
MONGO_URI=mongodb://localhost:27017/schooldash

# Secret used to sign/verify JWTs
JWT_SECRET=your_super_secret_key_here

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173
